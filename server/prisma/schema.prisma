// =============================================================================
// CINEMA THEATRE BOOKING SYSTEM - PRISMA ORM SCHEMA
// Single Source of Truth mapping directly to the PostgreSQL Database
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum ScreenFormat {
  STANDARD
  IMAX
  THREE_D     @map("3D")
  DOLBY_ATMOS
  FOUR_DX     @map("4DX")
  SCREENX

  @@map("screen_format_enum")
}

enum SeatTier {
  STANDARD
  VIP
  PREMIUM
  RECLINER

  @@map("seat_tier_enum")
}

enum AgeRating {
  G
  PG
  PG_13
  R
  NC_17

  @@map("age_rating_enum")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED

  @@map("booking_status_enum")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status_enum")
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY

  @@map("payment_method_enum")
}

// =============================================================================
// MODELS
// =============================================================================

model Theatre {
  theatre_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  city        String   @db.VarChar(100)
  location    String   @db.VarChar(255)
  distance_km Decimal? @default(0.0) @db.Decimal(4, 1)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  screens Screen[]

  @@unique([name, city], map: "uk_theatre_name_city")
  @@index([city], map: "idx_theatres_city")
  @@map("theatres")
}

model Screen {
  screen_id   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  theatre_id  String       @db.Uuid
  screen_name String       @db.VarChar(100)
  format      ScreenFormat @default(STANDARD)
  total_seats Int
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  theatre Theatre @relation(fields: [theatre_id], references: [theatre_id], onDelete: Cascade)
  seats   Seat[]
  shows   Show[]

  @@unique([theatre_id, screen_name], map: "uk_theatre_screen")
  @@index([theatre_id], map: "idx_screens_theatre_id")
  @@map("screens")
}

model Seat {
  seat_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screen_id        String   @db.Uuid
  row_identifier   String   @db.VarChar(4)
  seat_number      Int
  seat_tier        SeatTier @default(STANDARD)
  price_multiplier Decimal  @default(1.00) @db.Decimal(3, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  screen        Screen        @relation(fields: [screen_id], references: [screen_id], onDelete: Cascade)
  booking_seats BookingSeat[]

  @@unique([screen_id, row_identifier, seat_number], map: "uk_screen_seat")
  @@index([screen_id], map: "idx_seats_screen_id")
  @@map("seats")
}

model Movie {
  movie_id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String         @unique(map: "uk_movie_title") @db.VarChar(255)
  synopsis          String
  duration_minutes  Int
  language          String         @default("English") @db.VarChar(50)
  rating            AgeRating      @default(PG_13)
  imdb_rating       Decimal?       @db.Decimal(3, 1)
  genres            String[]
  supported_formats ScreenFormat[] @default([STANDARD])
  backdrop_url      String?
  poster_url        String?
  blurhash          String?        @db.VarChar(100)
  release_date      DateTime?      @db.Date
  is_active         Boolean        @default(true)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  shows Show[]

  @@index([is_active], map: "idx_movies_is_active")
  @@index([rating], map: "idx_movies_rating")
  @@map("movies")
}

model Show {
  show_id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movie_id    String       @db.Uuid
  screen_id   String       @db.Uuid
  show_date   DateTime     @db.Date
  start_time  DateTime     @db.Time(6)
  end_time    DateTime     @db.Time(6)
  format      ScreenFormat
  base_price  Decimal      @db.Decimal(10, 2)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  movie         Movie         @relation(fields: [movie_id], references: [movie_id], onDelete: Restrict)
  screen        Screen        @relation(fields: [screen_id], references: [screen_id], onDelete: Cascade)
  bookings      Booking[]
  booking_seats BookingSeat[]

  @@unique([screen_id, show_date, start_time], map: "uk_screen_show_schedule")
  @@index([movie_id, show_date], map: "idx_shows_movie_date")
  @@index([screen_id, show_date], map: "idx_shows_screen_date")
  @@index([show_date, is_active], map: "idx_shows_date_active")
  @@map("shows")
}

model Booking {
  booking_id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference String        @unique @db.VarChar(32)
  show_id           String        @db.Uuid
  user_id           String        @db.VarChar(128)
  user_email        String        @db.VarChar(255)
  user_name         String        @db.VarChar(255)
  subtotal          Decimal       @db.Decimal(10, 2)
  tax_amount        Decimal       @default(0.00) @db.Decimal(10, 2)
  convenience_fee   Decimal       @default(0.00) @db.Decimal(10, 2)
  total_amount      Decimal       @db.Decimal(10, 2)
  status            BookingStatus @default(PENDING)
  qr_code_payload   String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  show          Show          @relation(fields: [show_id], references: [show_id], onDelete: Restrict)
  booking_seats BookingSeat[]
  payments      Payment[]

  @@index([show_id], map: "idx_bookings_show_id")
  @@index([user_email], map: "idx_bookings_user_email")
  @@index([status], map: "idx_bookings_status")
  @@index([booking_reference], map: "idx_bookings_reference")
  @@map("bookings")
}

model BookingSeat {
  booking_seat_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String   @db.Uuid
  seat_id         String   @db.Uuid
  show_id         String   @db.Uuid
  price_paid      Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seat_id], references: [seat_id], onDelete: Restrict)
  show    Show    @relation(fields: [show_id], references: [show_id], onDelete: Restrict)

  @@unique([booking_id, seat_id], map: "uk_booking_seat")
  @@unique([show_id, seat_id], map: "idx_no_double_booking_active_seat")
  @@index([seat_id], map: "idx_booking_seats_seat_id")
  @@index([show_id], map: "idx_booking_seats_show_id")
  @@map("booking_seats")
}

model Payment {
  payment_id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id              String        @db.Uuid
  idempotency_key         String        @unique(map: "idx_payments_idempotency_key") @db.VarChar(128)
  amount                  Decimal       @db.Decimal(10, 2)
  payment_method          PaymentMethod @default(CARD)
  status                  PaymentStatus @default(PENDING)
  provider_transaction_id String?       @db.VarChar(255)
  error_message           String?
  created_at              DateTime      @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Restrict)

  @@index([booking_id], map: "idx_payments_booking_id")
  @@map("payments")
}
